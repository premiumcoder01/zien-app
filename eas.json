{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal-testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed-testing": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "open-testing": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
