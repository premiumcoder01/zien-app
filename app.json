{
  "expo": {
    "name": "Zien",
    "slug": "Zien",
    "version": "5.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zien",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propfyi",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "27",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "18.219.170.119": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        },
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload and manage property images.",
        "NSCameraUsageDescription": "This app needs access to your camera to capture property photos and videos.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save photos to your library.",
        "NSCalendarsUsageDescription": "This app needs access to your calendar to schedule property viewings and appointments.",
        "NSRemindersUsageDescription": "This app needs access to reminders to help you manage follow-ups and tasks.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record property videos and use voice commands.",
        "NSSpeechRecognitionUsageDescription": "This app needs speech recognition to allow you to command Zien with your voice.",
        "NSUserNotificationUsageDescription": "Zien sends you real-time alerts for new leads, property updates, and important CRM activity.",
        "LSApplicationQueriesSchemes": [
          "mailto"
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBxs1NkCMn1ny24-4fGnBVsbwMyTSWBDr8"
      }
    },
    "android": {
      "package": "com.propfyi",
      "googleServicesFile": "./google-services.json",
      "versionCode": 114,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "zien"
            },
            {
              "scheme": "https",
              "host": "zien.ai"
            },
            {
              "scheme": "https",
              "host": "staging.zien.ai"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAZM9Ef3yGGfgAX12z0Hv5CZkft2lRyFSQ"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0a2341"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.643931044813-tfbh0a8f1q69g0vthql6pl1r4vpf7l3u"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zien needs access to your photo library to upload and manage property images.",
          "cameraPermission": "Zien needs access to your camera to capture property photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow $(PRODUCT_NAME) to use your location"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Zien needs access to your calendar to schedule property viewings and manage your social posting timeline.",
          "remindersPermission": "Zien needs access to reminders to help you track follow-ups and task deadlines."
        }
      ],
      "expo-speech-recognition",
      "./with-pods-fix",
      "./withAndroidAlertDialogCasing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed74813d-5b63-41ce-a0d7-d176593d86c1"
      }
    }
  }
}